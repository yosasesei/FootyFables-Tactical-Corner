# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GAS_API_URL: Default Google Apps Script Web App (/exec) URL for Google Sheets + Live Proxy backend.
# Can also be overridden dynamically at runtime inside Admin Settings.
VITE_GAS_API_URL="https://script.google.com/macros/s/AKfycbyo9NgU03Twi9TuJW78LqULD6lUhaaqs_W-1gPU_GsyHjLZlgYfkp_nKSW3s_9kdCbR1w/exec"
